-/// Take ownership of the 7 per-layer raw weight tensors from the raw-weight
-/// map.  Returns `None` and leaves the map partially drained if any are
-/// missing (callers discard the drained entries).
+// WASM prefill/warmup uses CPU kernels, which support raw Q8_0 but not Q4_0.
+// Keep each original f16 scale and unpack signed nibbles into Q8_0 bytes.
+// This changes storage only: every decoded weight is bit-for-bit identical.
+// GPU decoding uses the expanded representation too; native loading is unchanged.
+#[cfg(any(target_arch = "wasm32", test))]
+pub(crate) fn expand_q4_0_for_cpu(weight: &mut RawWeight) -> Result<(), GgufError> {
+    use flare_core::model::WeightFormat;
+    if weight.format != WeightFormat::Q4_0 { return Ok(()); }
+    let blocks = weight.num_rows.checked_mul(weight.blocks_per_row)
+        .ok_or_else(|| GgufError::InvalidFormat("Q4_0 block count overflow".into()))?;
+    let expected = blocks.checked_mul(18)
+        .ok_or_else(|| GgufError::InvalidFormat("Q4_0 byte count overflow".into()))?;
+    if weight.data.len() != expected {
+        return Err(GgufError::InvalidFormat("Malformed Q4_0 blocks".into()));
+    }
+    let capacity = blocks.checked_mul(34)
+        .ok_or_else(|| GgufError::InvalidFormat("Q8_0 byte count overflow".into()))?;
+    let mut expanded = Vec::with_capacity(capacity);
+    for block in weight.data.chunks_exact(18) {
+        expanded.extend_from_slice(&block[..2]);
+        for &packed in &block[2..] { expanded.push(((packed & 15) as i8 - 8) as u8); }
+        for &packed in &block[2..] { expanded.push(((packed >> 4) as i8 - 8) as u8); }
+    }
+    weight.data = expanded;
+    weight.format = WeightFormat::Q8_0;
+    Ok(())
+}
