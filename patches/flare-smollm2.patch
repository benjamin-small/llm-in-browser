+// llama.cpp's Llama GGUF exporter interleaves Q/K rows for adjacent-pair RoPE.
+// Flare rotates split halves (as in the original Hugging Face model). Restore
+// that row layout at the GGUF boundary, including the raw quantized GPU weights.
+// Safetensors and other architectures must retain their existing layout.
+fn normalize_llama_gguf_rope(
+    gguf: &GgufFile,
+    tensors: &mut HashMap<String, Tensor>,
+    raw_map: &mut HashMap<String, RawWeight>,
+) -> Result<(), GgufError> {
+    if gguf.architecture() != Some("llama") { return Ok(()); }
+    let config = gguf.to_model_config()?;
+    for layer in 0..config.num_layers {
+        for (kind, heads) in [("q", config.num_heads), ("k", config.num_kv_heads)] {
+            for suffix in ["weight", "bias"] {
+                let name = format!("blk.{layer}.attn_{kind}.{suffix}");
+                let rows = heads * config.head_dim;
+                if let Some(tensor) = tensors.get_mut(&name) {
+                    // The browser may intentionally omit the f32 copy.
+                    if !tensor.data().is_empty() {
+                        undo_interleaved_rows(tensor.data_mut(), rows, heads)?;
+                    }
+                }
+                if let Some(raw) = raw_map.get_mut(&name) {
+                    if raw.num_rows != rows {
+                        return Err(GgufError::InvalidFormat(format!("Unexpected Q/K shape: {name}")));
+                    }
+                    undo_interleaved_rows(&mut raw.data, rows, heads)?;
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn undo_interleaved_rows<T: Copy>(data: &mut [T], rows: usize, heads: usize) -> Result<(), GgufError> {
+    if heads == 0 || rows == 0 || rows % (2 * heads) != 0 || data.len() % rows != 0 {
+        return Err(GgufError::InvalidFormat("Invalid Llama rotary weight dimensions".into()));
+    }
+    let cols = data.len() / rows;
+    let dim = rows / heads;
+    let original = data.to_vec();
+    for head in 0..heads {
+        for row in 0..dim {
+            let source_row = head * dim + 2 * (row % (dim / 2)) + row / (dim / 2);
+            let target_row = head * dim + row;
+            data[target_row * cols..(target_row + 1) * cols]
+                .copy_from_slice(&original[source_row * cols..(source_row + 1) * cols]);
+        }
+    }
+    Ok(())
+}
