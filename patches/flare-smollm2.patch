+// Equivalent to Digits(individual_digits=true), followed by GPT-2 ByteLevel.
+// Rust regex lacks lookahead; handle the whitespace negative lookahead explicitly.
+fn smollm_pieces(text: &str) -> Vec<&str> {
+    use std::sync::OnceLock;
+    static DIGITS: OnceLock<regex::Regex> = OnceLock::new();
+    static BYTE_LEVEL: OnceLock<regex::Regex> = OnceLock::new();
+    let digits = DIGITS.get_or_init(|| regex::Regex::new(r"\p{N}").unwrap());
+    let byte_level = BYTE_LEVEL.get_or_init(|| regex::Regex::new(
+        r"'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+"
+    ).unwrap());
+    let mut segments = Vec::new();
+    let mut start = 0;
+    for digit in digits.find_iter(text) {
+        if start < digit.start() { segments.push(&text[start..digit.start()]); }
+        segments.push(digit.as_str());
+        start = digit.end();
+    }
+    if start < text.len() { segments.push(&text[start..]); }
+    let mut pieces = Vec::new();
+    for segment in segments {
+        let mut offset = 0;
+        while let Some(m) = byte_level.find_at(segment, offset) {
+            let mut end = m.end();
+            if end < segment.len() && m.as_str().chars().all(char::is_whitespace) {
+                // \s+(?!\S) consumes all but the last whitespace before text.
+                // That last character is then matched independently, or prefixes a word.
+                let last = m.as_str().char_indices().last().unwrap().0;
+                if last > 0 { end = m.start() + last; }
+            }
+            pieces.push(&segment[m.start()..end]);
+            offset = end;
+        }
+    }
+    pieces
+}
