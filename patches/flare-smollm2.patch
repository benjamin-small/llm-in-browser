+    fn test_q4_0_expansion_preserves_signed_nibbles_and_scales() {
+        use flare_core::model::WeightFormat;
+        let mut data = Vec::new();
+        for scale in [0x3c00u16, 0xbc00u16] {
+            data.extend_from_slice(&scale.to_le_bytes());
+            data.extend((0u8..16).map(|i| i | ((15-i) << 4)));
+        }
+        let mut raw = RawWeight { data, format: WeightFormat::Q4_0, num_rows: 2, blocks_per_row: 1 };
+        expand_q4_0_for_cpu(&mut raw).unwrap();
+        assert_eq!(raw.format, WeightFormat::Q8_0);
+        assert_eq!(raw.data.len(), 68);
+        for (block, scale) in raw.data.chunks_exact(34).zip([0x3c00u16, 0xbc00u16]) {
+            assert_eq!(&block[..2], &scale.to_le_bytes());
+            for i in 0..16 {
+                assert_eq!(block[2+i] as i8, i as i8-8);
+                assert_eq!(block[18+i] as i8, 7-i as i8);
+            }
+        }
+    }
