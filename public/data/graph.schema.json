{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aster knowledge graph, version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "name", "entities", "facts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "datasetVersion": {"type": "string", "minLength": 1, "maxLength": 500},
    "name": {"type": "string", "minLength": 1, "maxLength": 500},
    "entities": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/entity"}},
    "facts": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/fact"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,100}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"},
        "aliases": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/text"}},
        "properties": {"type": "object", "maxProperties": 30, "additionalProperties": {"$ref": "#/$defs/text"}}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "subject", "predicate"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/text"},
        "object": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "value": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      },
      "oneOf": [
        {"required": ["object"], "properties": {"object": {"$ref": "#/$defs/id"}, "value": {"type": "null"}}},
        {"required": ["value"], "properties": {"value": {"$ref": "#/$defs/text"}, "object": {"type": "null"}}}
      ]
    }
  }
}
